# Flask session-signing secret. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# SHA-256 hash of the Settings-page login password (not the password itself). Generate with:
#   python3 -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
SETTINGS_PASSWORD_SHA256=

# SHA-256 hash of the static REST API key (not the key itself). Sent by
# external clients as the X-API-Key header against /api/external/*. Generate with:
#   python3 -c "import hashlib; print(hashlib.sha256(b'yourapikey').hexdigest())"
API_KEY_SHA256=

# Set to "false" only for local HTTP-only development, so the session
# cookie is sent without HTTPS. Leave "true" (or unset) in production --
# the settings-page login will not work over plain HTTP otherwise.
SESSION_COOKIE_SECURE=true
